    {
      "parameters": {
        "jsCode": "// Divide el Markdown en un fragmento por sección (##) y subsección (###),\n// agregando un encabezado contextual (breadcrumb) y el número de sección como metadato.\nfunction dividir(md, docLabel) {\n  const lineas = md.replace(/\\r/g, '').split('\\n');\n  const bloques = []; let actual = null; let padre = '';\n  const cerrar = () => { if (actual) bloques.push(actual); };\n  for (const l of lineas) {\n    const h2 = l.match(/^##\\s+(\\d+)\\.\\s*(.+)$/);\n    const h3 = l.match(/^###\\s+(\\d+\\.\\d+)\\s+(.+)$/);\n    if (h2) { cerrar(); padre = `${h2[1]}. ${h2[2].trim()}`; actual = { seccion: h2[1], titulo: padre, cuerpo: [] }; continue; }\n    if (h3) { cerrar(); actual = { seccion: h3[1], titulo: `${padre} › ${h3[1]} ${h3[2].trim()}`, cuerpo: [] }; continue; }\n    if (!actual) actual = { seccion: '0', titulo: 'Encabezado y alcance del documento', cuerpo: [] };\n    actual.cuerpo.push(l);\n  }\n  cerrar();\n  return bloques\n    .map(b => ({ ...b, cuerpo: b.cuerpo.join('\\n').replace(/^#\\s+.*$/m, '').trim() }))\n    .filter(b => b.cuerpo.length > 0)\n    .map(b => ({ seccion: b.seccion, titulo: b.titulo,\n                 texto: `${docLabel} · Sección ${b.titulo}\\n\\n${b.cuerpo}` }));\n}\n\n\n// --- Entrada: archivo .md del formulario (después de borrar la versión anterior)\nconst item = $input.first();\nconst key = Object.keys(item.binary || {})[0];\nif (!key) throw new Error('No se recibió el archivo Markdown.');\nconst md = (await this.helpers.getBinaryDataBuffer(0, key)).toString('utf8');\nconst f = $('Cargar documento').first().json;\nconst etiqueta = `${f['Nombre del documento']} (${f['Codigo documento']})`;\n\nreturn dividir(md, etiqueta).map(b => ({ json: {\n  texto: b.texto,\n  seccion: b.seccion,\n  titulo: b.titulo\n}}));"
      },
